(* Gramatica de sintaxe do Micro C, adaptada para a EBNF do TP2. *)
TOKENS
INT = /int/;
CHAR = /char/;
MAIN = /main/;
IF = /if/;
ELSE = /else/;
FOR = /for/;
RETURN = /return/;
PRINT = /print/;
ID = /[a-zA-Z_][a-zA-Z0-9_]*/;
INTEGERCONST = /[0-9]+/;
CHARCONST = /'([^'\\\n]|\\[nt0r\\'\"])'/;
STRINGCONST = /"([^"\\\n]|\\.)*"/;
PLUS = /\+/;
MINUS = /-/;
MUL = /\*/;
DIV = /\//;
MOD = /%/;
EQ = /==/;
NEQ = /!=/;
LT = /</;
GT = />/;
LEQ = /<=/;
GEQ = />=/;
AND = /&&/;
OR = /\|\|/;
NOT = /!/;
ASSIGN = /=/;
SEMICOLON = /;/;
COMMA = /,/;
LPAREN = /\(/;
RPAREN = /\)/;
LBRACE = /\{/;
RBRACE = /\}/;
LBRACKET = /\[/;
RBRACKET = /\]/;
SKIP = /[ \t\r\n]+/;

RULES
programa = INT MAIN LPAREN RPAREN bloco;
bloco = LBRACE { declaracao } { comando } RBRACE;
declaracao = tipo ID [ LBRACKET INTEGERCONST RBRACKET ] SEMICOLON;
tipo = INT | CHAR;
comando = comando_if | comando_for | atribuicao | comando_return | comando_print | bloco | SEMICOLON;
comando_if = IF LPAREN expressao RPAREN comando [ ELSE comando ];
comando_for = FOR LPAREN atribuicao_interna SEMICOLON expressao SEMICOLON atribuicao_interna RPAREN comando;
comando_return = RETURN [ expressao ] SEMICOLON;
comando_print = PRINT LPAREN conteudo_print RPAREN SEMICOLON;
conteudo_print = STRINGCONST | expressao;
atribuicao = atribuicao_interna SEMICOLON;
atribuicao_interna = ID [ LBRACKET expressao RBRACKET ] ASSIGN expressao;
expressao = expressao_logica;
expressao_logica = expressao_relacional { ( AND | OR ) expressao_relacional };
expressao_relacional = expressao_aritmetica [ operador_relacional expressao_aritmetica ];
operador_relacional = EQ | NEQ | LT | GT | LEQ | GEQ;
expressao_aritmetica = termo { ( PLUS | MINUS ) termo };
termo = fator { ( MUL | DIV | MOD ) fator };
fator = LPAREN expressao RPAREN | ID [ LBRACKET expressao RBRACKET ] | INTEGERCONST | CHARCONST | NOT fator;
