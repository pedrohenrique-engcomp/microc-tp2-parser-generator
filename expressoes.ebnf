(* Gramatica LL(1) para expressoes aritmeticas. *)
TOKENS
INTEGERCONST = /[0-9]+/;
ID = /[a-zA-Z_][a-zA-Z0-9_]*/;
PLUS = /\+/;
MINUS = /-/;
MUL = /\*/;
DIV = /\//;
LPAREN = /\(/;
RPAREN = /\)/;
SKIP = /[ \t\r\n]+/;

RULES
expr = term { (PLUS | MINUS) term };
term = factor { (MUL | DIV) factor };
factor = INTEGERCONST | ID | LPAREN expr RPAREN;
